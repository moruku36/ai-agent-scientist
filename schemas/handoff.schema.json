{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference-only handoff (design harness-handoff/1)",
  "$comment": "Design contract only. Runtime semantic checks and authorization are required.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic",
    "message_id",
    "request_id",
    "attempt_id",
    "replicate_id",
    "project_id",
    "sender",
    "recipient",
    "kind",
    "in_reply_to",
    "expected_revision",
    "authorization_ref",
    "budget_reservation_ref",
    "payload",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "harness-handoff/1"
    },
    "synthetic": {
      "type": "boolean"
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "replicate_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "sender": {
      "enum": [
        "scientist",
        "ctf",
        "sleep",
        "evaluator"
      ]
    },
    "recipient": {
      "enum": [
        "scientist",
        "ctf",
        "sleep",
        "evaluator"
      ]
    },
    "kind": {
      "enum": [
        "request",
        "status",
        "result",
        "cancel"
      ]
    },
    "in_reply_to": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "authorization_ref": {
      "type": "string",
      "minLength": 1
    },
    "budget_reservation_ref": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "media_type",
        "classification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "synthetic",
            "private",
            "reviewed_export"
          ]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "status",
              "result",
              "cancel"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "in_reply_to": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          }
        }
      },
      "then": {
        "properties": {
          "attempt_id": {
            "type": "null"
          },
          "in_reply_to": {
            "type": "null"
          }
        }
      }
    }
  ]
}
