{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run receipt (design contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "attempt_id",
    "replicate_id",
    "project_id",
    "protocol_revision",
    "candidate_revision",
    "status",
    "validity",
    "artifacts",
    "metrics",
    "usage",
    "limitations"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "replicate_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_revision": {
      "type": "string",
      "minLength": 1
    },
    "candidate_revision": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed",
        "timeout",
        "cancelled",
        "rejected"
      ]
    },
    "validity": {
      "enum": [
        "unchecked",
        "valid",
        "invalid",
        "inconclusive"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "enum": [
              "input",
              "source",
              "environment",
              "raw_output",
              "derived",
              "metric_receipt"
            ]
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "incremental_api_usd"
      ],
      "properties": {
        "wall_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "incremental_api_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
