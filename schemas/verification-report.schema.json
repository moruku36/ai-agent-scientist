{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic",
    "report_id",
    "project_id",
    "contract",
    "candidate",
    "configuration",
    "run_id",
    "attempt_id",
    "inputs",
    "dependency_closure",
    "evaluator",
    "toolchain",
    "environment",
    "issuer_id",
    "issued_at",
    "outcome",
    "evidence",
    "claims",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "verification-report/1"
    },
    "synthetic": {
      "type": "boolean"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "$ref": "#/$defs/ref"
    },
    "candidate": {
      "$ref": "#/$defs/ref"
    },
    "configuration": {
      "$ref": "#/$defs/ref"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "minItems": 1
    },
    "dependency_closure": {
      "$ref": "#/$defs/ref"
    },
    "evaluator": {
      "$ref": "#/$defs/ref"
    },
    "toolchain": {
      "$ref": "#/$defs/ref"
    },
    "environment": {
      "$ref": "#/$defs/ref"
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "outcome": {
      "enum": [
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "minItems": 0
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "statement",
          "scope",
          "assurance_type",
          "outcome",
          "evidence"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "assurance_type": {
            "enum": [
              "empirical_check",
              "formal_proof"
            ]
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "inconclusive"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "minItems": 0
          },
          "formal_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "theorem",
              "assumptions",
              "axiom_audit",
              "proof_artifact",
              "toolchain",
              "independent_verification_receipt",
              "verification_scope"
            ],
            "properties": {
              "theorem": {
                "$ref": "#/$defs/ref"
              },
              "assumptions": {
                "$ref": "#/$defs/ref"
              },
              "axiom_audit": {
                "$ref": "#/$defs/ref"
              },
              "proof_artifact": {
                "$ref": "#/$defs/ref"
              },
              "toolchain": {
                "$ref": "#/$defs/ref"
              },
              "independent_verification_receipt": {
                "$ref": "#/$defs/ref"
              },
              "verification_scope": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "assurance_type": {
                  "const": "formal_proof"
                },
                "outcome": {
                  "const": "passed"
                }
              },
              "required": [
                "assurance_type",
                "outcome"
              ]
            },
            "then": {
              "required": [
                "formal_evidence"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "passed"
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ref"
                  },
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bound verification receipt (design only)",
  "$comment": "Issuer strings and passed outcomes are untrusted until authenticated and checked independently of the candidate. Formal proof is scoped to its exact theorem, assumptions, trusted toolchain and cost model, not scientific truth.",
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "outcome": {
            "const": "inconclusive"
          },
          "claims": {
            "items": {
              "properties": {
                "outcome": {
                  "const": "inconclusive"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "minItems": 1
          },
          "claims": {
            "items": {
              "properties": {
                "outcome": {
                  "const": "passed"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
